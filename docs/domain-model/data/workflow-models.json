        { "state": "leaf", "on": "cmd-record-judgment", "kind": "ignored", "reason": "評価は未調査の枝の順位付けにだけ使う", "changed": true },
        { "state": "rejected", "on": "cmd-record-judgment", "kind": "ignored", "reason": "評価は未調査の枝の順位付けにだけ使う", "changed": true },
        { "state": "hypothesis", "on": "cmd-record-judgment", "kind": "ignored", "reason": "評価は未調査の枝の順位付けにだけ使う", "changed": true }
